{
  "name": "reading-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A simple, light reading dashboard — world news, economics research, and essays as tiles.",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
